{
  "harness": "Claude Code (claude -p --model haiku --tools \"\" --setting-sources \"\" --no-session-persistence)",
  "seller": {
    "cmd": "python seller_r3.py --port {port}"
  },
  "buyer": {
    "cmd": "python buyer.py --url {url} --item {item} --budget {budget}"
  },
  "market_buyer": {
    "cmd": "python market_buyer.py --shops {shops} --item {item} --budget {budget} --order {order}"
  },
  "review": {
    "cmd": "python review_r3.py --deal {deal}"
  },
  "restock": {
    "cmd": "python restock_r3.py --state {state}"
  }
}
